# Pick one provider. Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=sk-...
# Optional overrides
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
FREE_QUESTIONS_PER_DAY=20
